# a `domestic' makefile for MS-DOS Player (for 20150108 build).
# 20150108 lpproj
#

#
# gcc (mingw + msys)
#
D = /
O = o
A = a
#X = 
X = .exe
MKDIR = mkdir -p
RM_F = rm -f
CP = cp
CC = gcc
CXX = g++ 
CFLAGS_OO=-o $@
CFLAGS_OX=-o $@
CFLAGS= -Wall -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function -Wno-sign-compare -fno-omit-frame-pointer -fno-strict-aliasing -fpermissive -D_MBCS -DNDEBUG -D_MT -D_MB_MAP_DIRECT
CXXFLAGS = $(CFLAGS)
LD = $(CXX)
LIBS = -lwinmm -lpsapi -lwsock32 -lgdi32 -lmpr -luuid -lsetupapi -lwinspool
LDFLAGS = -mconsole -static -static-libgcc
LDFLAGS_NTVDM = -shared -s -static-libgcc -Wl,--enable-stdcall-fixup -Wl,--kill-at

ifdef DEBUG
CFLAGS += -Og -g
else
CFLAGS += -O3 -s
endif

ifdef DEBUGGER
CFLAGS += -DUSE_DEBUGGER
endif

ifdef LOG
CFLAGS += -DENABLE_DEBUG_LOG
endif

#
# Visual C++/WinSDK Command Prompt (with nmake)
#
#D = \ 
#O = obj
#A = lib
#X = .exe
#MKDIR = mkdir
#RM_F = del 2>nul /F /Q
#CP = copy /Y
#CC = cl
#CXX = cl
#CFLAGS_OO = /Fo$@
#CFLAGS_OX = /Fe$@
#CFLAGS= /nologo /W4 /O2 /EHsc /D_MT /DWIN32 /D_MBCS /D_CONSOLE /DNDEBUG /DSUPPORT_DISASSEMBLER /errorReport:none
#CXXFLAGS = $(CFLAGS)
#LIBS = user32.lib winmm.lib psapi.lib wsock32.lib
#LDFLAGS = /MT


#
.SUFFIXES:
#.SUFFIXES: $(X) .$(A) .$(O) .cpp .c .h

CFLAGS_I86 = $(CFLAGS) -I. -DHAS_I86
CXXFLAGS_I86 = $(CFLAGS_I86)
CFLAGS_V30 = $(CFLAGS) -I. -DHAS_V30
CXXFLAGS_V30 = $(CFLAGS_V30)
CFLAGS_I286 = $(CFLAGS) -I. -DHAS_I286
CXXFLAGS_I286 = $(CFLAGS_I286) 
CFLAGS_I386 = $(CFLAGS) -I. -DHAS_I386 -Imame/lib/softfloat/source/include
CXXFLAGS_I386 = $(CFLAGS_I386)
CFLAGS_I486 = $(CFLAGS) -I. -DHAS_I486 -Imame/lib/softfloat/source/include
CXXFLAGS_I486 = $(CFLAGS_I486)

#COMPILE = $(CC) $(CFLAGS) $(CFLAGS_EXTRA) $(CFLAGS_OO) $?


SRCD_BASE = .$(D)
SRCD_EMUCPU = $(SRCD_BASE)mame$(D)emu$(D)cpu$(D)
SRCD_I86 = $(SRCD_EMUCPU)i86$(D)
SRCD_I386 = $(SRCD_EMUCPU)i386$(D)
SRCD_PRINT = $(SRCD_BASE)np21_print$(D)

OUTD_BASE = .$(D)binary$(D)
#OUTD_BASE = .$(D)

#TARGET_I286 = $(OUTD_BASE)i286$(D)msdos$(X)
#TARGET_I386 = $(OUTD_BASE)i386$(D)msdos$(X)
#TARGET_I486 = $(OUTD_BASE)i486$(D)msdos$(X)
TARGET_I86 = $(OUTD_BASE)msdos_i86$(X)
TARGET_V30 = $(OUTD_BASE)msdos_V30$(X)
TARGET_I286 = $(OUTD_BASE)msdos_i286$(X)
TARGET_I386 = $(OUTD_BASE)msdos_i386$(X)
TARGET_I486 = $(OUTD_BASE)msdos_i486$(X)
TARGET_NTVDM = $(OUTD_BASE)ntvdm$(X)

SRCS_I86 = \
	$(SRCD_I86)ea.h \
	$(SRCD_I86)host.h \
	$(SRCD_I86)i86.c \
	$(SRCD_I86)i86.h \
	$(SRCD_I86)i86priv.h \
	$(SRCD_I86)i86time.c \
	$(SRCD_I86)instr186.c \
	$(SRCD_I86)instr186.h \
	$(SRCD_I86)instr86.c \
	$(SRCD_I86)instr86.h \
	$(SRCD_I86)modrm.h \
	$(SRCD_I86)table186.h \
	$(SRCD_I86)table86.h

SRCS_I286 = \
	$(SRCS_I86) \
	$(SRCD_I86)i286.c \
	$(SRCD_I86)instr286.c \
	$(SRCD_I86)instr286.h \
	$(SRCD_I86)i286.h \
	$(SRCD_I86)modrm286.h \
	$(SRCD_I86)table286.h

SRCS_I386DASM = \
	$(SRCD_I386)i386dasm.c

SRCS_I86DASM = $(SRCS_I386DASM)

SRCS_I386 = \
	$(SRCD_I386)cycles.h \
	$(SRCD_I386)i386.c \
	$(SRCD_I386)i386.h \
	$(SRCD_I386)i386op16.c \
	$(SRCD_I386)i386op32.c \
	$(SRCD_I386)i386ops.c \
	$(SRCD_I386)i386ops.h \
	$(SRCD_I386)i386priv.h \
	$(SRCD_I386)pentops.c \
	$(SRCD_I386)x87ops.c \
	$(SRCD_EMUCPU)vtlb.c \
	$(SRCD_EMUCPU)vtlb.h

SRCS_I486 = \
	$(SRCS_I386) \
	$(SRCD_I386)i486ops.c

SRCS_PENTIUM = \
	$(SRCS_I486) \
	$(SRCD_I386)pentops.c

SRCS_PRINT = \
	$(SRCD_PRINT)codecnv$(D)eucsjis.cpp \
	$(SRCD_PRINT)codecnv$(D)eucucs2.cpp \
	$(SRCD_PRINT)codecnv$(D)sjiseuc.cpp \
	$(SRCD_PRINT)codecnv$(D)sjisucs2.cpp \
	$(SRCD_PRINT)codecnv$(D)tcswap16.cpp \
	$(SRCD_PRINT)codecnv$(D)tcswap32.cpp \
	$(SRCD_PRINT)codecnv$(D)textcnv.cpp \
	$(SRCD_PRINT)codecnv$(D)ucs2sjis.cpp \
	$(SRCD_PRINT)codecnv$(D)ucs2utf8.cpp \
	$(SRCD_PRINT)codecnv$(D)utf8ucs2.cpp \
	$(SRCD_PRINT)print$(D)cmdparser.cpp \
	$(SRCD_PRINT)print$(D)pmbase.cpp \
	$(SRCD_PRINT)print$(D)pmescp.cpp \
	$(SRCD_PRINT)print$(D)pmpr201.cpp \
	$(SRCD_PRINT)cmbase.cpp \
	$(SRCD_PRINT)cmfile.cpp \
	$(SRCD_PRINT)cmpara.cpp \
	$(SRCD_PRINT)cmpipe.cpp \
	$(SRCD_PRINT)cmspooler.cpp

all : i86 v30 i286 i386 i486 ntvdm

i86: $(TARGET_I86)

v30: $(TARGET_V30)

i286: $(TARGET_I286)

i386: $(TARGET_I386)

i486: $(TARGET_I486)

ntvdm: $(TARGET_NTVDM)

$(TARGET_I86) : $(SRCD_BASE)msdos.cpp $(SRCD_BASE)msdos.h $(SRCS_I86) $(SRCS_I86DASM) $(SRCS_PRINT)
	$(CXX) $(CXXFLAGS_I86) $(CFLAGS_EXTRA) \
		$(CFLAGS_OX) \
		$(SRCD_BASE)msdos.cpp $(SRCS_PRINT) \
		$(LIBS) $(LIBS_EXTRA) \
		$(LDFLAGS) $(LDFLAGS_EXTRA)

$(TARGET_V30) : $(SRCD_BASE)msdos.cpp $(SRCD_BASE)msdos.h $(SRCS_I86) $(SRCS_I86DASM) $(SRCS_PRINT)
	$(CXX) $(CXXFLAGS_V30) $(CFLAGS_EXTRA) \
		$(CFLAGS_OX) \
		$(SRCD_BASE)msdos.cpp $(SRCS_PRINT) \
		$(LIBS) $(LIBS_EXTRA) \
		$(LDFLAGS) $(LDFLAGS_EXTRA)

$(TARGET_I286) : $(SRCD_BASE)msdos.cpp $(SRCD_BASE)msdos.h $(SRCS_I286) $(SRCS_I86DASM) $(SRCS_PRINT)
	$(CXX) $(CXXFLAGS_I286) $(CFLAGS_EXTRA) \
		$(CFLAGS_OX) \
		$(SRCD_BASE)msdos.cpp $(SRCS_PRINT) \
		$(LIBS) $(LIBS_EXTRA) \
		$(LDFLAGS) $(LDFLAGS_EXTRA)

$(TARGET_I386) : $(SRCD_BASE)msdos.cpp $(SRCD_BASE)msdos.h $(SRCS_I386) $(SRCS_I386DASM) $(SRCS_PRINT)
	$(CXX) $(CXXFLAGS_I386) $(CFLAGS_EXTRA) \
		$(CFLAGS_OX) \
		$(SRCD_BASE)msdos.cpp $(SRCS_PRINT) \
		$(LIBS) $(LIBS_EXTRA) \
		$(LDFLAGS) $(LDFLAGS_EXTRA)

$(TARGET_I486) : $(SRCD_BASE)msdos.cpp $(SRCD_BASE)msdos.h $(SRCS_I486) $(SRCS_I386DASM) $(SRCS_PRINT)
	$(CXX) $(CXXFLAGS_I486) $(CFLAGS_EXTRA) \
		$(CFLAGS_OX) \
		$(SRCD_BASE)msdos.cpp $(SRCS_PRINT) \
		$(LIBS) $(LIBS_EXTRA) \
		$(LDFLAGS) $(LDFLAGS_EXTRA)

$(TARGET_NTVDM) : $(SRCD_BASE)ntvdm.c $(SRCD_BASE)ntvdm.def
	$(CC) $(CFLAGS) $(CFLAGS_OX) $(SRCD_BASE)ntvdm.c $(SRCD_BASE)ntvdm.def $(LDFLAGS_NTVDM)

clean:
	-$(RM_F) $(TARGET_I286)
	-$(RM_F) $(TARGET_I386)
	-$(RM_F) $(TARGET_I486)
	-$(RM_F) $(TARGET_NTVDM)

